# App
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload CMS
PAYLOAD_SECRET=your-secret-here-min-32-chars

# Database — Neon PostgreSQL (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shopify Storefront API
# Get from: Shopify Admin → Apps → Develop apps → API credentials
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-public-access-token

# Shopify Admin API (for webhooks / server-side sync)
SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-access-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Vercel Blob (media storage in production)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
